{
  "name": "bindarr-frontend",
  "private": true,
  "version": "1.8.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs && node scripts/build-device-backend.mjs",
    "predev": "node scripts/copy-ort.mjs && node scripts/build-device-backend.mjs",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "check:locales": "node scripts/check-locales.mjs",
    "preview": "vite preview",
