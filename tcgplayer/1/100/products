eInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"OracleText","displayName":"Rules Text Contains","value":""}]},{"productId":35750,"name":"Scars of Mirrodin - Booster Box Case (6 Booster Boxes)","cleanName":"Scars of Mirrodin Booster Box Case 6 Booster Boxes","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/35750_200w.jpg","categoryId":1,"groupId":100,"url":"https://www.tcgplayer.com/product/35750/magic-scars-of-mirrodin-scars-of-mirrodin-booster-box-case-6-booster-boxes","modifiedOn":"2015-09-02T12:40:03.157","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[]},{"productId":36375,"name":"Poison Counter Token","cleanName":"Poison Counter Token","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/36375_200w.jpg","categoryId":1,"groupId":100,"url":"https://www.tcgplayer.com/product/36375/magic-scars-of-mirrodin-poison-counter-token","modifiedOn":"2025-12-09T20:17:38.983","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"Rarity","displayName":"Rarity","value":"T"}]},{"productId":196801,"name":"Scars of Mirrodin Intro Pack - Myr of Mirrodin","cleanName":"Scars of Mirrodin Intro Pack Myr of Mirrodin","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/196801_200w.jpg","categoryId":1,"groupId":100,"url":"https://www.tcgplayer.com/product/196801/magic-scars-of-mirrodin-scars-of-mirrodin-intro-pack-myr-of-mirrodin","modifiedOn":"2019-08-12T16:53:23.43","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"OracleText","displayName":"Rules Text Contains","value":"The \"Myr of Mirrodin\" deck combines Myr artifact creatures with powerful white cards. Your goal? Overpowering your opponent with an Inspired Charge to give each of your creatures +2/+1. You'll have lots of help maximizing the number of creatures you have on the battlefield. With Myrsmith on the battlefield, you'll get a 1/1 Myr artifact creature every time you cast an artifact! Contains 60 cards plus a 15 card booster pack."}]},{"productId":196802,"name":"Scars of Mirrodin Intro Pack - Metalcraft","cleanName":"Scars of Mirrodin Intro Pack Metalcraft","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/196802_200w.jpg","categoryId":1,"groupId":100,"url":"https://www.tcgplayer.com/product/196802/magic-scars-of-mirrodin-scars-of-mirrodin-intro-pack-metalcraft","modifiedOn":"2019-08-12T16:54:15.287","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"OracleText","displayName":"Rules Text Contains","value":"With the \"Metalcraft\" deck, you'll be taking advantage of a powerful new ability from the Scars of Mirrodin set. When you accumulate three artifacts on the battlefield, your creatures and spells with metalcraft will become even more powerful. Galvanic Blast doubles in damage from 2 to 4, all for a single red mana! Need help finding artifacts? Trinket Mage does the work for you, searching for cards like Memnite when it enters the battlefield. Contains 60 cards plus a 15 card booster pack."}]},{"productId":196803,"name":"Scars of Mirrodin Intro Pack - Deadspread","cleanName":"Scars of Mirrodin Intro Pack Deadspread","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/196803_200w.jpg","categoryId":1,"groupId":100,"url":"https://www.tcgplayer.com/product/196803/magic-scars-of-mirrodin-scars-of-mirrodin-intro-pack-deadspread","modifiedOn":"2019-08-12T16:54:56.14","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"OracleText","displayName":"Rules Text Contains","value":"With the \"Deadspread\" deck, you'll reap a lot of rewards for a little bit of work. Your aim is to control your opponent's creatures by giving them -1/-1 counters. Then you'll proliferate, a new ability that allows you to add counters to permanents and players that have them. A single -1/-1 counter will soon become a real nightmare for careless opponents as you use Fume Spitter and proliferate to spread death. Or use the 6/6 Carnifex Demon to spread counters while flying in for some massive damage. Contains 60 cards plus a 15 card booster pack."}]},{"productId":196804,"name":"Scars of Mirrodin Intro Pack - Relic Breaker","cleanName":"Scars of Mirrodin Intro Pack Relic Breaker","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/196804_200w.jpg","categoryId":1,"groupId":100,"url":"https://www.tcgplayer.com/product/196804/magic-scars-of-mirrodin-scars-of-mirrodin-intro-pack-relic-breaker","modifiedOn":"2019-08-12T16:55:38.67","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"OracleText","displayName":"Rules Text Contains","value":"With the \"Relic Breaker\" deck, you'll punish your opponents who rely on the many artifact goodies in the Scars of Mirrodin set. The name of the game is beating your opponents down while blowing up virtually every card they play. Trouble from a creature that's picked up a pesky Equipment? Turn to Slag will deal 5 damage to the creature and blow up the Equipment all at once. Hoard- Smelter Dragon will eat your opponent's artifacts and attack much stronger for doing it. Contains 60 cards plus a 15 card booster pack."}]},{"productId":196805,"name":"Scars of Mirrodin Intro Pack - Phyrexian Poison","cleanName":"Scars of Mirrodin Intro Pack Phyrexian Poison","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/196805_200w.jpg","categoryId":1,"groupId":100,"url":"https://www.tcgplayer.com/product/196805/magic-scars-of-mirrodin-scars-of-mirrodin-intro-pack-phyrexian-poison","modifiedOn":"2019-08-12T16:56:20.273","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"OracleText","displayName":"Rules Text Contains","value":"The \"Phyrexian Poison\" deck returns to an age-old victory path for defeating your opponents: poison! Infect your opponent with ten poison counters and you win the game. Putrefax can reach half that goal with one swing, while your Ichor Rats and Necropedes can make steady progress in the early game. The powerful infect ability ensures that your creatures' impact will be felt long after they're gone. Contains 60 cards plus a 15 card booster pack."}]},{"productId":686504,"name":"Scars of Mirrodin - Intro Pack [Set of 5]","cleanName":"Scars of Mirrodin Intro Pack Set of 5","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/686504_200w.jpg","categoryId":1,"groupId":100,"url":"https://www.tcgplayer.com/product/686504/magic-scars-of-mirrodin-scars-of-mirrodin-intro-pack-set-of-5","modifiedOn":"2026-03-31T13:46:54.953","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"OracleText","displayName":"Rules Text Contains","value":"This set contain one of each of the Scars of Mirrodin Intro Packs.\r\n<br>• 1 Scars of Mirrodin Intro Pack - Relic Breaker\r\n<br>• 1 Scars of Mirrodin Intro Pack - Phyrexian Poison\r\n<br>• 1 Scars of Mirrodin Intro Pack - Myr of Mirrodin\r\n<br>• 1 Scars of Mirrodin Intro Pack - Metalcraft\r\n<br>• 1 Scars of Mirrodin Intro Pack - Deadspread"}]}]}