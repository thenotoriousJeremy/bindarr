2025-03-28T19:41:25.233","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"Rarity","displayName":"Rarity","value":"R"},{"name":"SubType","displayName":"Creature Type or Sub Type","value":"Sorcery"},{"name":"OracleText","displayName":"Rules Text Contains","value":"Put four Citizen tokens into play. Treat these tokens as 1/1 white creatures."},{"name":"FlavorText","displayName":"Flavor","value":"<em>Icatia's once-peaceful towns faced increasing attacks from orcs and goblins as the climate cooled. By the time the empire fell, they were little more than armed camps.</em>"}]},{"productId":2209,"name":"Ice Floe","cleanName":"Ice Floe","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/2209_200w.jpg","categoryId":1,"groupId":44,"url":"https://www.tcgplayer.com/product/2209/magic-fifth-edition-ice-floe","modifiedOn":"2025-03-28T19:41:55.46","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"Rarity","displayName":"Rarity","value":"U"},{"name":"SubType","displayName":"Creature Type or Sub Type","value":"Land"},{"name":"OracleText","displayName":"Rules Text Contains","value":"You may choose not to untap Ice Floe during your untap phase.\r\n<br>\r\nT: Tap target creature without flying that is attacking you. As long as Ice Floe remains tapped, that creature does not untap during its controller’s untap phase."}]},{"productId":2210,"name":"Imposing Visage","cleanName":"Imposing Visage","imageUrl":"https://tcgplayer-cdn.tcgplayer.com/product/2210_200w.jpg","categoryId":1,"groupId":44,"url":"https://www.tcgplayer.com/product/2210/magic-fifth-edition-imposing-visage","modifiedOn":"2025-03-28T19:42:44.63","imageCount":1,"presaleInfo":{"isPresale":false,"releasedOn":null,"note":null},"extendedData":[{"name":"Rarity","displayName":"Rarity","value":"C"},{"name":"SubType","displayName":"Creature Type or Sub Type","value":"Enchant Creature"},{"name":"OracleText","displayName":"R