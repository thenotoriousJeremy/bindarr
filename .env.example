# Bindarr Environment Configuration Example

# The port the API and web app will be served on inside the container/local machine
PORT=3001

# Optional: also serve the SAME app over HTTPS on this port (the Docker image
# defaults it to 3443; a downloaded/local server leaves it off). Both ports serve
# identical content — HTTP is what you point a reverse proxy at, HTTPS is what you
# use directly when there is no proxy. Card scanning needs it: browsers only allow
# camera access in a secure context, so http://<lan-ip>:3001 can't scan while
# https://<lan-ip>:3443 can. Unset = HTTP only.
HTTPS_PORT=

# Optional: your own certificate for that HTTPS port. With both unset, a
# self-signed certificate is generated next to the database on first start and
# reused after (browsers show a one-time "unknown issuer" warning to click past).
SSL_CERT_PATH=
SSL_KEY_PATH=

# The file path where the SQLite database will be created/loaded
DB_PATH=./backend/database/bindarr.db

# Optional: automatic database backups. Each one is written to a temporary file,
# checked (PRAGMA quick_check) and only then renamed to a .bak, so a backup cut
# short by a full disk never looks like a good one.
#
# BACKUP_DIR: where backups go, and where Admin -> Database Backup lists and
# downloads them from. Defaults to a backups/ folder beside DB_PATH. Point it at
# another disk or a mount that is itself copied off the box.
# BACKUP_INTERVAL_HOURS: hours between automatic backups (default 24, 0 disables;
# 0.25 to 8784). The last backup time is kept in the database, so restarts do not
# delay it. An unreadable value falls back to 24 and says so in the log.
# BACKUP_KEEP_LAST: how many regular backups to keep (default 10). Snapshots taken
# before an upgrade migrates the database (pre-migration-*.bak) are kept apart:
# the newest 3, whatever this is set to.
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=
BACKUP_KEEP_LAST=

# Optional, and only useful if you already hold a key: this raises the rate limit
# for the pokemontcg.io provider.
#
# pokemontcg.io is deprecated. New registrations are closed and existing keys stop
# working on 1 March 2027 (https://dev.pokemontcg.io/). Bindarr defaults new
# installs to TCGdex, which needs no key at all — leave this blank for those.
POKEMON_TCG_API_KEY=

# Optional: override the TCGCSV API base URL, for example to use a local
# read-through cache. The endpoint must serve /last-updated.txt and the
# /tcgplayer/... paths used by TCGCSV. Defaults to https://tcgcsv.com.
TCGCSV_BASE_URL=

# Optional: override the RiftCodex API host (Riftbound card data), e.g. for a
# local mirror or the tests. Defaults to https://api.riftcodex.com.
RIFTCODEX_BASE_URL=

# Comma-separated list of origins allowed to call the API (CORS). Defaults to
# the Vite dev server + same-origin production. Set this to your real domain
# when deploying somewhere other than localhost.
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Optional: the canonical externally-reachable URL for this instance, used to
# build collection share links. Set this when running behind a reverse proxy
# where the browser's own origin (protocol+host) isn't the address others
# should use to reach your share links, e.g. https://cards.example.com
# Can also be overridden later by an admin from the Admin Panel without
# redeploying.
PUBLIC_BASE_URL=

# Optional: set a known password for the auto-created "admin" account on first
# run. If unset, a random password is generated and printed once to the
# server logs on first startup — check the logs to retrieve it.
DEFAULT_ADMIN_PASSWORD=

# Open self-registration. Default (unset/false) = invite-only: only an admin can
# create accounts (Admin panel). Set to "true" to let anyone self-register a
# member account from the login screen.
ALLOW_REGISTRATION=

# The Content-Security-Policy is enforced: the browser refuses scripts that are
# not the app's own, and card images from hosts the policy does not list. If card
# art stops showing after a provider moves to a new image host, set this to "true"
# until Bindarr is updated: the same policy is then only reported (in the browser
# console) instead of enforced. Leave it unset otherwise.
CSP_REPORT_ONLY=

# Set this when the app runs behind a reverse proxy that terminates TLS
# (nginx/Traefik/Caddy). Makes req.ip and the rate limiters use the real client
# IP from X-Forwarded-For. Use the number of proxy hops in front of the app
# (usually "1"), or "true". Leave UNSET when the app is directly exposed —
# trusting the header otherwise lets clients spoof their IP past the rate limiter.
TRUST_PROXY=

# Notifications (Settings -> Notifications) are sent by this server to URLs your
# users type in: Discord, ntfy, Apprise or any webhook. To stop an account using
# that to reach things only the server can reach, destinations on loopback
# (127.0.0.1, localhost), private LAN ranges (10.x, 172.16-31.x, 192.168.x, CGNAT
# 100.64.x) and IPv6 unique-local addresses are refused by default.
#
# Self-hosters often run ntfy, Apprise or Home Assistant on the same LAN or
# Docker network as Bindarr, which is exactly that kind of address. Set this to
# "true" to allow them — sensible when every account on this instance is someone
# you trust with access to your network. Link-local addresses (169.254.x, which
# includes cloud metadata services) stay blocked either way.
NOTIFY_ALLOW_PRIVATE=

# Optional pokemontcgapi.com provider. Select it in Admin -> Instance Settings.
# This server-side key is separate from POKEMON_TCG_API_KEY.
POKEMONTCGAPI_KEY=

# Instance-wide collection and runtime metrics. Default off.
METRICS_ENABLED=false

# Expose admin-panel metrics at GET /metrics, including per-user collection
# counts and values. This endpoint is unauthenticated; restrict network access.
# Enabling it also enables API/provider instrumentation. Default off.
PROMETHEUS_METRICS_ENABLED=false
# Port for the isolated Prometheus-only listener (used only when enabled).
PROMETHEUS_PORT=9100

# TCGCSV mirror — NOT LIVE YET. Once the project's daily mirror is approved by
# the TCGCSV maintainer and switched on, point TCGCSV_BASE_URL (on a release
# that supports it) at the mirror so this install reads Pokémon prices from it
# instead of contacting tcgcsv.com. See "TCGCSV mirror" in README.md.
# TCGCSV_BASE_URL=https://raw.githubusercontent.com/thenotoriousJeremy/bindarr/tcgcsv-mirror

# Optional OIDC / SSO login: see the OIDC_* variables in README.md. Register
# <PUBLIC_BASE_URL>/api/auth/oidc/callback as the redirect URI at your provider.
#
# If the provider's certificate is signed by a private root CA, login fails with
# "fetch failed" and the log names a certificate error such as
# UNABLE_TO_VERIFY_LEAF_SIGNATURE. Node does not read the OS certificate store,
# so adding the CA to the container's system store does not help; point
# NODE_EXTRA_CA_CERTS at the CA's PEM file instead. Node reads it once at
# startup, so it must be in the process environment (docker-compose
# `environment:`, systemd, your shell). Setting it in this .env file does nothing.
# NODE_EXTRA_CA_CERTS=/certs/root-ca.pem
