# An allowlist: the build context is what the Dockerfile copies and nothing
# else. The old denylist matched names at the root only, so a developer's build
# sent backend/.env, nested databases and the .claude/ worktrees (1.5 GB) along
# with it. A new COPY in the Dockerfile needs a line here.
*
!entrypoint.sh
!shared/
!backend/package.json
!backend/package-lock.json
!backend/src/
!backend/scripts/
!frontend/

# Inside what is let in: dependencies and build output are made in the image
# (a host's may be the wrong platform for native modules), and the native app
# projects are not part of the web build.
**/node_modules
frontend/dist
frontend/android
frontend/ios

# Never, wherever they are.
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite
**/*.log
**/.DS_Store
