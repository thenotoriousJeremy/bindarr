{
  "name": "Bindarr Enhanced Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": { "label": "Bindarr test instance", "onAutoForward": "notify", "protocol": "http", "visibility": "private" }
  },
  "remoteEnv": {
    "DB_PATH": "${containerWorkspaceFolder}/.devcontainer/data/bindarr.db",
    "PORT": "3001",
    "HTTPS_PORT": "",
    "ALLOW_REGISTRATION": "false"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
